// OpenCode's system config, mounted at `/etc/opencode/opencode.jsonc`: OpenCode
// merges it over the user's and project's configs, so these settings can't be
// overridden. The models are left to the user's `opencode.json`.
{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "provider": {
        "llamacpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp (host)",
            "options": {
                "baseURL": "http://llm.internal:8080/v1",
                "apiKey": "{file:/run/secrets/llm-api-key}"
            }
        }
    }
}
