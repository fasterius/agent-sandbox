#!/usr/bin/env bash
set -euo pipefail

# Run an agent in the sandbox with the current directory as the project, or
# build its image. In the `open` mode the agent has
# unrestricted egress (`compose/<agent>-egress-open.yml` is layered on top of
# `compose/<agent>.yml` to drop the proxy); in the `filtered` mode all egress
# goes through the proxy and its allow-list; in the `closed` mode the agent can
# only reach its model, through the proxy for a remote one.

usage() {
    [[ "$1" -eq 0 ]] || exec >&2
    cat <<EOF
Usage: $(basename "$0") [options] <claude|opencode> [agent args]
       $(basename "$0") [options] build <claude|opencode>

Run an agent with the current directory as its project; any arguments after
the agent are passed on to it. \`build\` updates the agent's image and those
of its supporting services.

Options must come before the agent or command; those with an environment
variable shown can also be set with it.

  --filtered      Only allow egress to allow-listed hosts
  --closed        Only allow egress to the agent's model
                  (default: unrestricted egress)
  --arch ARCH     Image architecture, amd64 or arm64     SANDBOX_ARCH
                  (default: arm64)
  --memory SIZE   Memory limit (default: 4g)             SANDBOX_MEMORY
  --cpus N        CPU limit (default: 2)                 SANDBOX_CPUS
  --pids N        Process and thread limit               SANDBOX_PIDS
                  (default: 512)
  -h, --help      Show this help
EOF
    exit "$1"
}

die() {
    echo "Error: $*" >&2
    exit 1
}

# Defaults, overridden by the environment variables and then by the options
EGRESS="open"
SANDBOX_ARCH="${SANDBOX_ARCH:-arm64}"
SANDBOX_MEMORY="${SANDBOX_MEMORY:-4g}"
SANDBOX_CPUS="${SANDBOX_CPUS:-2}"
SANDBOX_PIDS="${SANDBOX_PIDS:-512}"

# Parse options until the first argument that does not start with `-` (the
# agent or command), so that it and everything after it is left untouched
while [[ $# -gt 0 && "$1" == -* ]]; do
    option="$1"
    value=""
    case "$option" in
        --arch=* | --memory=* | --cpus=* | --pids=*)
            value="${option#*=}"
            option="${option%%=*}"
            ;;
        --arch | --memory | --cpus | --pids)
            [[ $# -ge 2 ]] || die "option '$option' requires a value"
            value="$2"
            shift
            ;;
    esac
    case "$option" in
        -h | --help) usage 0 ;;
        --filtered) EGRESS=filtered ;;
        --closed) EGRESS=closed ;;
        --arch) SANDBOX_ARCH="$value" ;;
        --memory) SANDBOX_MEMORY="$value" ;;
        --cpus) SANDBOX_CPUS="$value" ;;
        --pids) SANDBOX_PIDS="$value" ;;
        *) die "unknown option '$option' (see --help)" ;;
    esac
    shift
done

[[ $# -ge 1 ]] || usage 1
COMMAND="$1"
shift
case "$COMMAND" in
    build)
        [[ $# -eq 1 ]] || usage 1
        AGENT="$1"
        shift
        ;;
    *)
        AGENT="$COMMAND"
        COMMAND="run"
        ;;
esac
case "$AGENT" in
    claude | opencode) ;;
    *)
        usage 1
        ;;
esac

case "$SANDBOX_ARCH" in
    amd64 | arm64) ;;
    *) die "architecture must be 'amd64' or 'arm64', not '$SANDBOX_ARCH'" ;;
esac
[[ "$SANDBOX_MEMORY" =~ ^[1-9][0-9]*[bkmgBKMG]?$ ]] ||
    die "memory limit must be a number with an optional b, k, m or g" \
        "suffix (e.g. 8g), not '$SANDBOX_MEMORY'"
[[ "$SANDBOX_CPUS" =~ ^[0-9]+(\.[0-9]+)?$ && "$SANDBOX_CPUS" =~ [1-9] ]] ||
    die "CPU limit must be a positive number, not '$SANDBOX_CPUS'"
[[ "$SANDBOX_PIDS" =~ ^[1-9][0-9]*$ ]] ||
    die "process limit must be a positive whole number, not '$SANDBOX_PIDS'"

# Resolve symlinks, so that the script can be linked into a directory on `PATH`
SANDBOX_DIR="$(dirname "$(readlink -f "$0")")"

# Per-user config, agent home directories and generated files live outside of
# the repository, in directories covered by the default `blocked-dirs`
CONFIG_DIR="$HOME/.config/agent-sandbox"
DATA_DIR="$HOME/.local/share/agent-sandbox"
STATE_DIR="$HOME/.local/state/agent-sandbox"

# Each agent and mode gets its own compose project, so that they get separate
# networks/containers instead of clashing over shared ones, and its own external
# home directory, so that each can have its own config and credentials
export SANDBOX_ARCH SANDBOX_MEMORY SANDBOX_CPUS SANDBOX_PIDS
export PROJECT_DIR="$PWD"
export AGENT_HOME="$DATA_DIR/$AGENT-$EGRESS"
export PROXY_FILTER="$STATE_DIR/filter-$AGENT-$EGRESS"
export COMPOSE_PROJECT_NAME="$AGENT-sandbox-egress-$EGRESS"
export COMPOSE_FILE="$SANDBOX_DIR/compose/$AGENT.yml"
if [[ "$EGRESS" == "open" ]]; then
    COMPOSE_FILE="$COMPOSE_FILE:$SANDBOX_DIR/compose/$AGENT-egress-open.yml"
fi

# The API key of OpenCode's model server; without one in the default location,
# an empty file is used instead, for a server without a key
if [[ -n "${SANDBOX_LLM_API_KEY_FILE:-}" ]]; then
    [[ -f "$SANDBOX_LLM_API_KEY_FILE" ]] ||
        die "API key file '$SANDBOX_LLM_API_KEY_FILE' does not exist"
    LLM_API_KEY_FILE="$SANDBOX_LLM_API_KEY_FILE"
elif [[ -f "$HOME/.local/share/llama.cpp/api-key" ]]; then
    LLM_API_KEY_FILE="$HOME/.local/share/llama.cpp/api-key"
else
    LLM_API_KEY_FILE="$STATE_DIR/no-api-key"
    mkdir -p "$STATE_DIR"
    touch "$LLM_API_KEY_FILE"
fi
export LLM_API_KEY_FILE

# The hosts the agent's model needs (none for a local model), and the
# allow-lists the proxy uses in each mode; the open mode has no proxy, and nor
# has the closed mode for an agent with a local model
MODEL_HOSTS="$SANDBOX_DIR/proxy/model-$AGENT"
ALLOW_LISTS=()
case "$EGRESS" in
    filtered)
        ALLOW_LISTS=(
            "$SANDBOX_DIR/proxy/allow-common"
            "$MODEL_HOSTS"
            "$CONFIG_DIR/allow-common"
            "$CONFIG_DIR/allow-$AGENT"
        )
        ;;
    closed)
        if [[ -f "$MODEL_HOSTS" ]]; then
            ALLOW_LISTS=("$MODEL_HOSTS")
        fi
        ;;
esac

# Combine the allow-lists into the proxy's filter file; succeeds only if its
# content changed, in which case the proxy has to be recreated to pick it up
update_filter() {
    local tmp source
    mkdir -p "$STATE_DIR"
    tmp="$(mktemp "$PROXY_FILTER.XXXXXX")"
    {
        echo "# Generated by agent-sandbox; edit the allow-lists instead"
        for source in "${ALLOW_LISTS[@]}"; do
            if [[ -f "$source" ]]; then
                cat "$source"
                echo
            fi
        done
    } > "$tmp"
    if cmp -s "$tmp" "$PROXY_FILTER"; then
        rm "$tmp"
        return 1
    fi
    mv "$tmp" "$PROXY_FILTER"
}

# Update all images: pull the supporting services' images and rebuild the
# agent's image from scratch, as its packages are not pinned and would
# otherwise be reused from the cache
if [[ "$COMMAND" == "build" ]]; then
    docker compose pull --ignore-buildable
    exec docker compose build --pull --no-cache "$AGENT"
fi

# Refuse to run in any directory listed in the default or per-user
# `blocked-dirs`
source "$SANDBOX_DIR/lib/check-dir.sh"

mkdir -p "$AGENT_HOME"
RUN_ARGS=(--rm)

# Agent-specific settings: the agent's config directory in its home directory,
# the name of its personal instructions file, default config files and
# supporting services besides the proxy
SERVICES=""
DEFAULTS=()
case "$AGENT" in
    claude)
        AGENT_CONFIG=".claude"
        INSTRUCTIONS="CLAUDE.md"
        ;;
    opencode)
        AGENT_CONFIG=".config/opencode"
        INSTRUCTIONS="AGENTS.md"
        DEFAULTS=(
            opencode/opencode-default.json
            opencode/tui-default.json
            opencode/session-bell-default.ts
        )
        SERVICES="llm"
        ;;
esac
USER_AGENT_CONFIG="$CONFIG_DIR/$AGENT"

# Mount the per-user files in `$CONFIG_DIR/<agent>/` read-only into the agent's
# config directory, so that they apply to all modes and can't be changed by the
# agent; the instructions file is merged below instead
mount_config() {
    local source="$1" target="$2"
    RUN_ARGS+=(-v "$(readlink -f "$source"):/home/dev/$AGENT_CONFIG/$target:ro")
}
for file in "$USER_AGENT_CONFIG"/*; do
    if [[ -f "$file" && "$(basename "$file")" != "$INSTRUCTIONS" ]]; then
        mount_config "$file" "$(basename "$file")"
    fi
done

# Mount the default config files without a per-user version read-only as well
for default in "${DEFAULTS[@]}"; do
    name="$(basename "${default/-default/}")"
    if [[ ! -f "$USER_AGENT_CONFIG/$name" ]]; then
        mount_config "$SANDBOX_DIR/$default" "$name"
    fi
done

# The proxy's filter is needed for the instructions in the filtered mode
FILTER_CHANGED=false
if [[ ${#ALLOW_LISTS[@]} -gt 0 ]] && update_filter; then
    FILTER_CHANGED=true
fi

# Merge the per-user instructions (shared by all agents, then agent-specific)
# with a description of the sandbox and its egress mode into the agent's
# personal instructions file
case "$SANDBOX_ARCH" in
    arm64) PLATFORM="linux-aarch64" OTHER_ARCH="amd64" ;;
    amd64) PLATFORM="linux-64" OTHER_ARCH="arm64" ;;
esac
GENERATED_INSTRUCTIONS="$STATE_DIR/instructions-$AGENT-$EGRESS.md"
mkdir -p "$STATE_DIR"
{
    for source in "$CONFIG_DIR/AGENTS.md" "$USER_AGENT_CONFIG/$INSTRUCTIONS"; do
        if [[ -f "$source" ]]; then
            cat "$source"
            echo
        fi
    done
    sed -e "s/@ARCH@/$SANDBOX_ARCH/" -e "s/@PLATFORM@/$PLATFORM/" \
        -e "s/@OTHER_ARCH@/$OTHER_ARCH/" "$SANDBOX_DIR/instructions/sandbox.md"
    # Describe the network restrictions and list the allowed hosts in a readable
    # form, _e.g._ `^.*\.example\.com$` becomes `*.example.com`
    if [[ "$EGRESS" != "open" ]]; then
        echo
        cat "$SANDBOX_DIR/instructions/egress-$EGRESS.md"
    fi
    if [[ "$EGRESS" == "filtered" ]]; then
        # shellcheck disable=SC2016
        sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/^\^//' -e 's/\$$//' \
            -e 's/\\\././g' -e 's/\.\*/*/g' -e 's/.*/- `&`/' "$PROXY_FILTER"
    fi
} > "$GENERATED_INSTRUCTIONS"
mount_config "$GENERATED_INSTRUCTIONS" "$INSTRUCTIONS"

# Mount the project's git settings and hooks read-only, as git on the host runs
# commands from them (_e.g._ `core.fsmonitor` on every `git status`); the agent
# can still stage and commit. Submodules keep theirs under `.git/modules/`. An
# empty hooks directory is created if missing, so that the agent can't add one
protect_git() {
    local git_dir="$1" target="/home/dev/workspace/${1#"$PWD"/}" file
    mkdir -p "$git_dir/hooks"
    RUN_ARGS+=(-v "$git_dir/hooks:$target/hooks:ro")
    for file in config config.worktree; do
        if [[ -f "$git_dir/$file" ]]; then
            RUN_ARGS+=(-v "$git_dir/$file:$target/$file:ro")
        fi
    done
}
if [[ -d "$PWD/.git" ]]; then
    protect_git "$PWD/.git"
    while IFS= read -r config; do
        protect_git "$(dirname "$config")"
    done < <(find "$PWD/.git/modules" -name config -type f 2> /dev/null)
fi

echo "Running $AGENT with $EGRESS egress ($SANDBOX_ARCH," \
    "$SANDBOX_MEMORY memory, $SANDBOX_CPUS CPUs, $SANDBOX_PIDS processes)" >&2

# Make sure the supporting services are running; `--no-deps` skips the proxy
# when the agent does not use it
if [[ ${#ALLOW_LISTS[@]} -gt 0 ]]; then
    if [[ "$FILTER_CHANGED" == true ]]; then
        docker compose up -d --force-recreate proxy
    fi
    SERVICES="proxy $SERVICES"
else
    RUN_ARGS+=(--no-deps)
fi
if [[ -n "${SERVICES// /}" ]]; then
    docker compose up -d $SERVICES
fi

# Run the agent interactively, forwarding any extra args
exec docker compose run "${RUN_ARGS[@]}" "$AGENT" "$AGENT" "$@"
